---
import { Github, FileText, ArrowUpRight } from 'lucide-astro';
---

<header class="sticky top-0 z-50 w-full border-b border-neutral-800/70 bg-[#0a0d12]/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand / Terminal Prompt Logo -->
    <a
      href="#"
      class="group inline-flex items-center gap-1.5 rounded-md border border-neutral-800 bg-neutral-900/70 px-3 py-1.5 font-mono text-xs sm:text-sm font-medium tracking-tight text-neutral-200 transition-all hover:border-emerald-500/40 hover:bg-neutral-900 hover:text-white"
    >
      <span class="text-sky-400">advait</span><span class="text-neutral-500">@</span><span class="text-emerald-400">palve</span><span class="text-neutral-400">:~#</span>
      <span class="inline-block h-3.5 w-1.5 bg-emerald-400 animate-[blink_1.1s_steps(1)_infinite] group-hover:bg-sky-400"></span>
    </a>

    <!-- Nav Links -->
    <nav class="flex items-center gap-1 sm:gap-2">
      <a
        href="#projects"
        class="rounded-md px-2.5 py-1.5 font-mono text-xs sm:text-sm font-medium text-neutral-400 transition-colors hover:bg-neutral-900 hover:text-neutral-100"
      >
        Projects
      </a>
      <a
        href="#skills"
        class="rounded-md px-2.5 py-1.5 font-mono text-xs sm:text-sm font-medium text-neutral-400 transition-colors hover:bg-neutral-900 hover:text-neutral-100"
      >
        Skills
      </a>
      <a
        href="https://github.com/AdvaitPalve11"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 rounded-md px-2.5 py-1.5 font-mono text-xs sm:text-sm font-medium text-neutral-400 transition-colors hover:bg-neutral-900 hover:text-neutral-100"
      >
        <Github class="h-3.5 w-3.5" />
        <span class="hidden sm:inline">GitHub</span>
        <ArrowUpRight class="h-3 w-3 text-neutral-500" />
      </a>
      <span
        aria-disabled="true"
        title="Resume coming soon"
        class="inline-flex cursor-not-allowed items-center gap-1 rounded-md border border-neutral-800 bg-neutral-900/50 px-2.5 py-1.5 font-mono text-xs sm:text-sm font-medium text-neutral-500"
      >
        <FileText class="h-3.5 w-3.5" />
        <span>Resume soon</span>
      </span>
    </nav>
  </div>
</header>
