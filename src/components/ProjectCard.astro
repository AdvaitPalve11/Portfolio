---
import { Github, ArrowUpRight, Terminal, Sparkles } from 'lucide-astro';

interface Props {
  title: string;
  category: string;
  summary: string;
  highlights?: string[];
  gifSrc: string;
  gifAlt: string;
  terminalTitle: string;
  statusText: string;
  techBadges: string[];
  githubUrl: string;
  reversed?: boolean;
}

const {
  title,
  category,
  summary,
  highlights = [],
  gifSrc,
  gifAlt,
  terminalTitle,
  statusText,
  techBadges,
  githubUrl,
  reversed = false,
} = Astro.props;
---

<article
  class="group relative overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900/60 backdrop-blur-sm transition-all duration-300 hover:border-neutral-700 hover:shadow-[0_8px_30px_rgba(0,0,0,0.5)]"
>
  <div class={`grid grid-cols-1 lg:grid-cols-12 items-stretch ${reversed ? 'lg:flex-row-reverse' : ''}`}>
    <!-- Media Column (Terminal GIF Preview) -->
    <div class={`lg:col-span-7 flex flex-col border-b lg:border-b-0 ${reversed ? 'lg:order-2 lg:border-l' : 'lg:border-r'} border-neutral-800 bg-black/40`}>
      <!-- Terminal Window Bar -->
      <div class="flex items-center justify-between border-b border-neutral-800 bg-neutral-900/90 px-4 py-2.5">
        <div class="flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-rose-500/80"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-amber-500/80"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-emerald-500/80"></span>
        </div>
        <div class="flex items-center gap-1.5 font-mono text-[11px] text-neutral-400">
          <Terminal class="h-3 w-3 text-neutral-500" />
          <span>{terminalTitle}</span>
        </div>
        <div class="w-10"></div>
      </div>

      <!-- GIF Container -->
      <div class="relative flex flex-1 items-center justify-center overflow-hidden bg-neutral-950 p-2 sm:p-3 min-h-[260px] sm:min-h-[300px]">
        <img
          src={gifSrc}
          alt={gifAlt}
          loading="lazy"
          class="h-full w-full max-h-[340px] rounded-lg object-contain object-center border border-neutral-800/80 transition-transform duration-500 group-hover:scale-[1.01]"
        />
      </div>

      <!-- Terminal Status Footer -->
      <div class="flex items-center justify-between border-t border-neutral-800 bg-neutral-950/90 px-4 py-2 font-mono text-[11px] text-neutral-400">
        <span class="inline-flex items-center gap-1.5 text-emerald-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
          {statusText}
        </span>
        <span class="text-neutral-500">x86_64 / C++</span>
      </div>
    </div>

    <!-- Technical Details Column -->
    <div class={`lg:col-span-5 flex flex-col justify-between p-6 sm:p-8 ${reversed ? 'lg:order-1' : ''}`}>
      <div>
        <!-- Category Tag -->
        <div class="inline-flex items-center gap-1.5 rounded border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 font-mono text-[11px] font-medium tracking-wide text-emerald-400 uppercase">
          <Sparkles class="h-3 w-3" />
          <span>{category}</span>
        </div>

        <!-- Project Title -->
        <h3 class="mt-4 font-mono text-2xl font-bold tracking-tight text-white group-hover:text-emerald-300 transition-colors">
          {title}
        </h3>

        <!-- Punchy Summary -->
        <p class="mt-3 text-sm leading-relaxed text-neutral-300">
          {summary}
        </p>

        <!-- Highlights (if any) -->
        {highlights.length > 0 && (
          <ul class="mt-4 space-y-1.5 text-xs text-neutral-400">
            {highlights.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-emerald-400 font-mono">›</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="mt-6 pt-6 border-t border-neutral-800/80">
        <!-- Tech Badges -->
        <div class="flex flex-wrap gap-1.5">
          {techBadges.map((badge) => (
            <span class="rounded border border-neutral-800 bg-neutral-900/80 px-2 py-0.5 font-mono text-[11px] text-neutral-400">
              {badge}
            </span>
          ))}
        </div>

        <!-- External Link -->
        <div class="mt-5">
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-md border border-neutral-700 bg-neutral-900 px-3.5 py-1.5 font-mono text-xs font-medium text-neutral-200 transition-all hover:border-emerald-500/50 hover:bg-neutral-800 hover:text-white"
          >
            <Github class="h-3.5 w-3.5" />
            <span>GitHub Repository</span>
            <ArrowUpRight class="h-3.5 w-3.5 text-neutral-400" />
          </a>
        </div>
      </div>
    </div>
  </div>
</article>
