---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Advait Palve · Systems & Computer Graphics Programmer",
  description = "Advait Palve (advaitpalve.com) — Systems Software & Computer Graphics Programmer. Specializing in x86_64 OS kernels, bare-metal architecture, and multithreaded C++ ray tracers.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://advaitpalve.com');
const socialImageURL = new URL('/assets/pfp.jpg', Astro.site || 'https://advaitpalve.com');

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Advait Palve',
  url: 'https://advaitpalve.com/',
  image: socialImageURL.href,
  jobTitle: 'Systems & Computer Graphics Programmer',
  description,
  email: 'mailto:advaitdpalve@gmail.com',
  sameAs: [
    'https://github.com/AdvaitPalve11',
    'https://www.linkedin.com/in/advaitpalve',
  ],
  knowsAbout: [
    'Systems programming',
    'Operating system kernels',
    'Computer graphics',
    'C++',
    'x86_64 architecture',
    'Ray tracing',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Advait Palve Portfolio',
  url: 'https://advaitpalve.com/',
  description,
  publisher: { '@type': 'Person', name: 'Advait Palve' },
};
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/assets/pfp.jpg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Advait Palve" />
    <meta name="keywords" content="Advait Palve, Advait Palve portfolio, Advait Palve programmer, Systems Programmer, Computer Graphics, C++, x86_64, Kernel, SyndromeOS, Ray Tracer, BVH, RBU Nagpur" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="googlebot" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Advait Palve Portfolio" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content="Advait Palve" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="Advait Palve" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen text-slate-200 antialiased selection:bg-emerald-500/20 selection:text-emerald-300">
    <div class="relative flex min-h-screen flex-col overflow-x-hidden">
      <slot />
    </div>
  </body>
</html>
