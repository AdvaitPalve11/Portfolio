---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Advait Palve · Systems & Computer Graphics Programmer",
  description = "Advait Palve (advaitpalve.com) — Systems Software & Computer Graphics Programmer. Specializing in x86_64 OS kernels, bare-metal architecture, and multithreaded C++ ray tracers.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://advaitpalve.com');
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%2202 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚡</text></svg>" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Advait Palve" />
    <meta name="keywords" content="Advait Palve, Systems Programmer, Computer Graphics, C++, x86_64, Kernel, SyndromeOS, Ray Tracer, BVH, RBU Nagpur" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/BootImage.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/assets/BootImage.png" />

    <!-- Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen text-slate-200 antialiased selection:bg-emerald-500/20 selection:text-emerald-300">
    <div class="relative flex min-h-screen flex-col overflow-x-hidden">
      <slot />
    </div>
  </body>
</html>
